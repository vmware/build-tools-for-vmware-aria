@startuml
title Process Flow of the Installer Script for Content Import and Clean Up

skinparam TitleFontSize 16
skinparam ActivityFontSize 12
skinparam ActivityBorderColor #2B579A
skinparam ActivityBackgroundColor #EFF6FF
skinparam activityDiamondBackgroundColor #90EE90
skinparam activityDiamondFontColor #003366
skinparam NoteBackgroundColor #FFFFFF
skinparam NoteBorderColor #B0BEC5
skinparam NoteFontSize 12
skinparam ConditionEndStyle hline 

start
if (\n     Is the Script Started with an Argument     \n     (Path to "".properties"" file)\n) then (Yes)
  :Load properties from "".properties"" file
  from command argument and proceed with the import;
else (No)
  :Start in Interactive Mode and show prompts
  to collect all required properties;
  start
endif

partition "Common Properties" {
  :
  ===Load Common Properties
                                                                                                     ;
}

partition Import Orchestrator Content {

  if (\n         Is the value of the ""vro_import_packages"" property         \n         set to ""true"" (""vro_import_packages=true"")?         \n) then (Yes - Import Orchestrator Content)

    :===Import Orchestrator Content;

  else (No - Proceed with Next Step)
  endif

}


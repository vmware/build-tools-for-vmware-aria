partition Clean Up Orchestrator Content - Bundle Versions {

  if (\n     Is the value of the ""vro_delete_last_version"" property     \n     set to ""true"" (""vro_delete_last_version=true"")?     \n) then (Yes - Clean Up Bundle Orchestrator Content)

    :===Clean Up Bundle Orchestrator Content
    (Current Versions from Bundle Packages);

  else (No - Proceed with Next Step)
  endif

}

